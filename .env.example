# Copy to .env and fill in. Never commit .env.

# Database: leave empty for a local SQLite file (pravi.db). For deployment use Neon Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# --- Document reading (optional LLM; the rule-based reader always runs) ---
# Open-source Qwen via OpenRouter:
OPENROUTER_API_KEY=
# LLM_MODEL=qwen/qwen3.6-27b

# Or a local / self-hosted open model (Ollama, vLLM):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Start with an empty inventory (only login accounts): SEED_DEMO=false
SEED_DEMO=true

# Reset demo data every start (true/false)
RESET_DB_ON_START=false
